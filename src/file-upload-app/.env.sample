# File Upload App Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.sample .env

# Azure Document Intelligence Endpoint
AZURE_DOCINTEL_ENDPOINT=

# Upload Configuration (optional)
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=16777216
PORT=8080

# Azure Client ID – only needed for Managed Identity in Azure
# Leave empty when using DefaultAzureCredential locally (az login)
AZURE_CLIENT_ID=

# Azure AI Foundry – required for agent workflow (agent_workflow.py)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.1-chat

# Optional: enable SharePoint grounding tool
SHAREPOINT_PROJECT_CONNECTION_ID=

# File classification markers (pipe-separated)
# First page of each uploaded file is scanned for these strings to auto-classify.
DESIGN_FILE_MARKERS=Medical Data Sheet:)
OTHER_FILE_MARKERS=Also medical
