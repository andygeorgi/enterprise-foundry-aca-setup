# ============================================================================
# Enterprise Foundry - Container Apps Module Configuration
# ============================================================================
# Copy this file to terraform.tfvars and fill in your values
# ============================================================================

# ======= Subscription & Location =======
subscription_id = "<your-azure-subscription-id>"
location        = "westeurope"

# ======= Resource Groups =======
rg_net = "rg-foundry-sbx-net"
rg_app = "rg-foundry-sbx-app"

# ======= ACA Environment (must exist - deploy aca_env module first) =======
aca_env_name = "cae-foundry-sbx"

# ======= Container Apps =======
app_onprem_name     = "aca-onprem-connectivity-test"
app_pe_storage_name = "aca-pe-storage-test"

# ======= Storage Account (must match network module) =======
storage_account_name   = "<your-storage-account-name>"
storage_container_name = "test"

# ======= Azure Container Registry (must match network module) =======
acr_name = "<your-acr-name>"

# ======= File Upload App Configuration =======
app_file_upload_name     = "aca-file-upload"
file_upload_image_name   = "file-upload-app"
file_upload_image_tag    = "latest"

# ======= Document Intelligence (optional - leave empty until ai_services module deployed) =======
# After deploying ai_services module, get the endpoint with:
#   cd ../ai_services
#   terraform output docintel_endpoint
docintel_endpoint = ""  # Example: "https://docintel-foundry-sbx.cognitiveservices.azure.com/"

# ======= Sample Agent Configuration =======
app_sample_agent_name          = "aca-sample-agent"
sample_agent_image_name        = "sample-agent"
sample_agent_image_tag         = "latest"
azure_ai_project_endpoint      = ""  # Example: "https://foundry-sbx.services.ai.azure.com/api/projects/default-project"
azure_ai_model_deployment_name = "gpt-4.1"
